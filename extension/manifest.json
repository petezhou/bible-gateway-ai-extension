{
  "manifest_version": 3,
  "minimum_chrome_version": "110",
  "name": "BibleGateway AI Study (Dev)",
  "version": "0.1.0",
  "description": "Highlight BibleGateway verses and ask questions using your local study server.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.biblegateway.com/passage/*", "https://biblegateway.com/passage/*"],
      "js": ["vendor/markdown.js", "selection.js", "content.js", "summary.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "BibleGateway AI settings"
  }
}
